{
  "name": "deptrace-cli",
  "version": "0.6.0",
  "description": "DepTrace: see your architecture. Catch violations before they ship.",
  "keywords": [
    "architecture",
    "cli",
    "typescript",
    "javascript",
    "dependencies"
  ],
  "license": "MIT",
  "author": "Sarthak Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarthxkz/DepTrace.git"
  },
  "homepage": "https://github.com/sarthxkz/DepTrace#readme",
  "bugs": {
    "url": "https://github.com/sarthxkz/DepTrace/issues"
  },
  "type": "module",
  "bin": {
    "deptrace": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup && vite build --config dashboard/vite.config.ts",
    "start": "node dist/index.js",
    "dashboard:dev": "vite --config dashboard/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config dashboard/playwright.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc -p dashboard --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "tsx scripts/benchmark.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picomatch": "^4.0.7",
    "semver": "^7.8.5",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "cytoscape": "^3.34.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
