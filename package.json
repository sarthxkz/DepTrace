{
  "name": "deptrace-cli",
  "version": "0.2.0",
  "description": "DepTrace: see your architecture. Catch violations before they ship.",
  "keywords": [
    "architecture",
    "cli",
    "typescript",
    "javascript",
    "dependencies"
  ],
  "type": "module",
  "bin": {
    "deptrace": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picomatch": "^4.0.7",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
